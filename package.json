{
  "name": "discord-minutes-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy:guild": "tsx src/deploy-commands.ts guild",
    "deploy:global": "tsx src/deploy-commands.ts global",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.0.0",
    "discord.js": "^14.26.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "pino": "^9.5.0",
    "prism-media": "^1.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
